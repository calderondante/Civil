# Never commit real values. Backend and worker share these variables.
STUDIO_ENV=development
STUDIO_DATA_DIR=./data
# Local default: SQLite. Supabase production: use its exact connection string.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=enter-securely-in-host-settings
SUPABASE_BUCKET=academic-audio
# In production: set a long random token in API and Next.js server only.
# API_BEARER_TOKEN=generate-a-random-secret
# API_URL=https://YOUR-PYTHON-API
# STUDIO_LOGIN_USER=your-workspace-user
# STUDIO_LOGIN_PASSWORD=generate-a-long-random-secret
# Gemini: obtain in Google AI Studio; put in API and worker secret settings.
# GEMINI_API_KEY=enter-securely-in-host-settings
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_PROTOCOL=interactions
# Text-generation model is independent from TTS; verify access in your account.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_AUDIT_MODEL=gemini-2.5-flash
# ElevenLabs: select two licensed voice IDs in the UI.
# ELEVENLABS_API_KEY=enter-securely-in-host-settings
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ASR is optional for review audio, mandatory for verified release.
# Install pip extras [asr] and set ASR_MODEL to a local faster-whisper model path
# or an accessible model ID (e.g. small). An uncached ID needs download access.
# ASR_MODEL=/models/faster-whisper-small
ASR_DEVICE=cpu
